{
  "manifest_version": "0.2",
  "name": "shamela-teaching",
  "display_name": "التحضير الموثَّق للدروس من المكتبة الشاملة — Shamela Teaching",
  "version": "0.1.0",
  "description": "تحضير دروس وأبحاث موثَّقة من نسختك المحلية من المكتبة الشاملة ٤: ملف مصادر يُتحقَّق فيه من كل نص مرتين ويُحفظ بلفظ الكتاب وموضعه الدائم، ودروس تميِّز النص الأصلي من الترجمة والتلخيص والشرح، مع قائمة بالتحققات المفتوحة. العربية هي الأصل، والترجمة (مثل الألمانية) طبقة إضافية اختيارية.",
  "long_description": "يضم هذا الخادم أدوات البحث والقراءة الأربع والثلاثين من مشروع shamela-mcp (حمود الحقباني، رخصة MIT)، ويضيف إليها طبقة للتدريس: مشاريع (سلسلة دروس مبنية على كتاب، أو بحث موضوعي) تُحفظ بين الجلسات؛ واختيار الكتاب الأصل والشروح؛ وتعيين الصفحات المطبوعة دون تخمين عند تعدد الأجزاء؛ وإضافة النصوص إلى ملف المصادر بعد جلب الصفحة كاملة والتحقق مرتين (مقارنة مستقلة + أداة التحقق في المحرك) وحفظ لفظ الكتاب نفسه مع بصمة النص؛ وإعادة التحقق واكتشاف تغيّر الصفحات؛ وطبقة ترجمة اختيارية تُربط فيها كل ترجمة بسياقها وبنص المصدر وبمسرد المصطلحات وتبقى «غير مراجَعة» حتى يراجعها إنسان؛ ودروس تتألف من فقرات موسومة (نص أصلي، ترجمة، تلخيص، شرح، نشاط) مع كشف النقل غير المميَّز؛ وتصدير بصيغ Markdown وHTML وJSON مع ملحق المصادر والتحققات المفتوحة. لا يكتب الخادم في بيانات الشاملة، ولا يحمل أي كتاب؛ وتُحفظ بيانات التدريس في مجلد مستقل تختاره.\n\nGerman: Quellenbasierte Unterrichtsvorbereitung aus der eigenen Shamela-4-Installation. Arabisch ist die Hauptsprache; eine kontextgenaue deutsche Übersetzung ist als Zusatzebene zuschaltbar.",
  "author": {
    "name": "Nik Frühschulz",
    "url": "https://github.com/nikcommits"
  },
  "homepage": "https://github.com/nikcommits/shamela-teaching-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikcommits/shamela-teaching-mcp"
  },
  "license": "MIT",
  "keywords": [
    "shamela",
    "الشاملة",
    "arabic",
    "islamic studies",
    "teaching",
    "citations",
    "translation"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "SHAMELA_INSTALL_ROOT": "${user_config.shamela_install_folder}",
        "SHAMELA_JRE": "${user_config.jre_path}",
        "TEACHING_DATA_DIR": "${user_config.data_folder}",
        "TEACHING_LANG": "${user_config.language}"
      }
    }
  },
  "user_config": {
    "shamela_install_folder": {
      "type": "directory",
      "title": "مجلد المكتبة الشاملة / Shamela-Ordner",
      "description": "المجلد الذي ثُبِّتت فيه المكتبة الشاملة ٤ (يحتوي database وapp). اتركه فارغًا للاكتشاف التلقائي. — Ordner der Shamela-4-Installation; leer lassen für automatische Erkennung.",
      "required": false,
      "default": ""
    },
    "data_folder": {
      "type": "directory",
      "title": "مجلد بيانات التدريس / Ordner für Unterrichtsdaten",
      "description": "مكان حفظ المشاريع وملفات المصادر والدروس والصادرات. اتركه فارغًا للمجلد الافتراضي للنظام. — Speicherort für Projekte, Quellenmappen, Einheiten und Exporte; leer = Standardordner des Systems.",
      "required": false,
      "default": ""
    },
    "language": {
      "type": "string",
      "title": "لغة الواجهة / Sprache der Oberfläche",
      "description": "ar للعربية (الافتراض)، de للألمانية، en للإنجليزية. النصوص الأصلية تبقى عربية دائمًا. — ar (Standard), de oder en. Originaltexte bleiben immer arabisch.",
      "required": false,
      "default": ""
    },
    "jre_path": {
      "type": "file",
      "title": "مسار جافا (متقدم) / Java (erweitert)",
      "description": "اتركه فارغًا لاستخدام جافا المرفقة مع الشاملة. — Leer lassen, um die mit Shamela gelieferte Java-Laufzeit zu verwenden.",
      "required": false,
      "default": ""
    }
  },
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  },
